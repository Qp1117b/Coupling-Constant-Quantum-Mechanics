import Mathlib.Data.Rat.Defs
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum

/-!
# `临-26`: A4 root charges under a compact U(1) reduction

A4 roots are α_ij = e_i - e_j on five labels.  An integral cocharacter h gives
root charges h_i - h_j ∈ ℤ; a half-integral "spin lift" gives charges in ½ℤ.
For a fundamental coweight (one label = 1, others 0), every charge is -1, 0 or 1.

No axiom, `sorry`, `admit`, `native_decide` or `unsafe` is used.
-/

namespace CQM.A4RootCharge

/-- The charge of root α_ij under the U(1) generated by h. -/
noncomputable def rootCharge (h : Fin 5 → ℚ) (i j : Fin 5) : ℚ := h i - h j

/-- An integral cocharacter gives integer root charges. -/
theorem integral_cocharacter_charge (h : Fin 5 → ℚ) (i j : Fin 5)
    (hint : ∀ k, ∃ z : ℤ, h k = z) : ∃ z : ℤ, rootCharge h i j = z := by
  obtain ⟨zi, hzi⟩ := hint i
  obtain ⟨zj, hzj⟩ := hint j
  refine ⟨zi - zj, ?_⟩
  unfold rootCharge
  rw [hzi, hzj]
  norm_num

/-- A half-integral cocharacter (spin lift) gives half-integer root charges. -/
theorem spin_cocharacter_charge (h : Fin 5 → ℚ) (i j : Fin 5)
    (hhalf : ∀ k, ∃ z : ℤ, h k = (z : ℚ) / 2) :
    ∃ z : ℤ, rootCharge h i j = (z : ℚ) / 2 := by
  obtain ⟨zi, hzi⟩ := hhalf i
  obtain ⟨zj, hzj⟩ := hhalf j
  refine ⟨zi - zj, ?_⟩
  unfold rootCharge
  rw [hzi, hzj, Int.cast_sub]
  ring

/-- Fundamental coweight: one label is 1, the rest 0. -/
noncomputable def omegaCoweight (k : Fin 5) (i : Fin 5) : ℚ := if i = k then 1 else 0

/-- Under a fundamental coweight every root charge is -1, 0 or 1. -/
theorem fundamental_coweight_charge (k i j : Fin 5) :
    rootCharge (omegaCoweight k) i j = 1 ∨
    rootCharge (omegaCoweight k) i j = 0 ∨
    rootCharge (omegaCoweight k) i j = -1 := by
  by_cases hi : i = k
  · by_cases hj : j = k
    · right; left
      simp [rootCharge, omegaCoweight, hi, hj]
    · left
      simp [rootCharge, omegaCoweight, hi, hj]
  · by_cases hj : j = k
    · right; right
      simp [rootCharge, omegaCoweight, hi, hj]
    · right; left
      simp [rootCharge, omegaCoweight, hi, hj]

/-- A root charge that is an integer automatically satisfies the G19
half-integer quantization (2s ∈ ℤ): the two constraints merge to s ∈ ℤ. -/
theorem merge_with_G19 (s : ℚ) (hroot : ∃ z : ℤ, s = z) : ∃ k : ℤ, 2 * s = k := by
  obtain ⟨z, hz⟩ := hroot
  refine ⟨2 * z, ?_⟩
  rw [hz]
  norm_num

end CQM.A4RootCharge
