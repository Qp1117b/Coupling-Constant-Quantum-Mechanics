import Mathlib.Data.Real.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Finset.Max
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum

open Matrix

/-- The three-node directed-circulation matrix `C = I + A`, with `A` skew-symmetric. -/
def Ccirc (a : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  Matrix.of fun i j =>
    if i = 0 then
      if j = 0 then 1 else if j = 1 then a else -a
    else if i = 1 then
      if j = 0 then -a else if j = 1 then 1 else a
    else
      if j = 0 then a else if j = 1 then -a else 1

/-- Every diagonal entry is one. -/
lemma Ccirc_diag (a : ℝ) : ∀ i : Fin 3, Ccirc a i i = 1 := by
  intro i
  fin_cases i <;> simp [Ccirc]

/-- Every row sums to one. -/
lemma Ccirc_row_sum (a : ℝ) : ∀ i : Fin 3, ∑ j : Fin 3, Ccirc a i j = 1 := by
  intro i
  fin_cases i <;> simp [Ccirc, Fin.sum_univ_three]

/-- The total off-diagonal sum is zero (the global A12 condition). -/
lemma Ccirc_global_offdiag_zero (a : ℝ) :
    (∑ i : Fin 3, ∑ j : Fin 3, if i = j then 0 else Ccirc a i j) = 0 := by
  simp [Ccirc, Fin.sum_univ_three]

/-- The off-diagonal part is nonzero when `a ≠ 0`. -/
lemma Ccirc_offdiag_nonzero (a : ℝ) (ha : a ≠ 0) : Ccirc a 0 1 ≠ 0 := by
  simp [Ccirc, ha]

/-- The matrix is not symmetric when `a ≠ 0`; it is a directed circulation. -/
lemma Ccirc_not_symmetric (a : ℝ) (ha : a ≠ 0) : Ccirc a 0 1 ≠ Ccirc a 1 0 := by
  simp [Ccirc]
  intro h
  apply ha
  linarith

/-- The circulation matrix is normal: `C Cᵀ = Cᵀ C`. -/
lemma Ccirc_normal (a : ℝ) : Ccirc a * (Ccirc a)ᵀ = (Ccirc a)ᵀ * Ccirc a := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Ccirc, Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_three]

/-- If `f` is injective, odd, and sign-preserving on `x ≥ 0`, then a skew
`f`-generated matrix with zero row sums has all node labels equal. -/
theorem sign_odd_row_zero_forces_all_equal
    {N : ℕ} [NeZero N]
    (f : ℝ → ℝ) (hinj : Function.Injective f)
    (hodd : ∀ x : ℝ, f (-x) = - f x)
    (hsign : ∀ x : ℝ, 0 ≤ x → 0 ≤ f x)
    (e : Fin N → ℝ)
    (hrow : ∀ i : Fin N, ∑ j : Fin N, f (e i - e j) = 0) :
    ∀ i j : Fin N, e i = e j := by
  classical
  have hf0 : f 0 = 0 := by
    have h := hodd 0
    simp only [neg_zero] at h
    linarith
  obtain ⟨i, _hi, hmax⟩ :=
    Finset.exists_max_image (Finset.univ : Finset (Fin N)) e Finset.univ_nonempty
  have hnonneg : ∀ j : Fin N, 0 ≤ f (e i - e j) := by
    intro j
    apply hsign
    exact sub_nonneg.mpr (hmax j (Finset.mem_univ j))
  have hzero : ∀ j : Fin N, f (e i - e j) = 0 := by
    have h := hrow i
    have h' := (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hnonneg j)).mp h
    intro j
    exact h' j (Finset.mem_univ j)
  have hall : ∀ j : Fin N, e j = e i := by
    intro j
    have hd : e i - e j = 0 := by
      apply hinj
      rw [hzero j, hf0]
    linarith
  intro i' j'
  rw [hall i', hall j']

/-- A three-node skew matrix with zero row sums cannot be generated by an injective
odd function of the differences: all three off-diagonal values must vanish. -/
theorem three_node_skew_row_zero_forces_zero
    (f : ℝ → ℝ) (hinj : Function.Injective f)
    (hodd : ∀ x : ℝ, f (-x) = - f x)
    (e : Fin 3 → ℝ)
    (hrow0 : f (e 0 - e 1) + f (e 0 - e 2) = 0)
    (hrow1 : - f (e 0 - e 1) + f (e 1 - e 2) = 0)
    (_hrow2 : - f (e 0 - e 2) - f (e 1 - e 2) = 0) :
    f (e 0 - e 1) = 0 ∧ f (e 0 - e 2) = 0 ∧ f (e 1 - e 2) = 0 := by
  have hB : f (e 0 - e 2) = - f (e 0 - e 1) := by linarith
  have hC : f (e 1 - e 2) = f (e 0 - e 1) := by linarith
  have hd02 : e 0 - e 2 = -(e 0 - e 1) := by
    apply hinj
    calc
      f (e 0 - e 2) = - f (e 0 - e 1) := hB
      _ = f (-(e 0 - e 1)) := (hodd (e 0 - e 1)).symm
  have hd12 : e 1 - e 2 = e 0 - e 1 := by
    apply hinj
    rw [hC]
  have hd20 : e 2 - e 0 = e 0 - e 1 := by linarith
  have hd01 : e 0 - e 1 = 0 := by linarith
  have hf0 : f 0 = 0 := by
    have h := hodd 0
    simp only [neg_zero] at h
    linarith
  have hA : f (e 0 - e 1) = 0 := by
    rw [hd01]
    exact hf0
  refine ⟨hA, ?_, ?_⟩
  · linarith
  · linarith

/-- The three-node circulation cannot be generated by an injective odd function
`f` of the differences. -/
theorem C3circ_not_from_injective_odd
    (f : ℝ → ℝ) (hinj : Function.Injective f)
    (hodd : ∀ x : ℝ, f (-x) = - f x)
    (e : Fin 3 → ℝ) (a : ℝ)
    (h01 : f (e 0 - e 1) = a)
    (h02 : f (e 0 - e 2) = -a)
    (h12 : f (e 1 - e 2) = a)
    (ha : a ≠ 0) : False := by
  have hd02 : e 0 - e 2 = -(e 0 - e 1) := by
    apply hinj
    calc
      f (e 0 - e 2) = -a := h02
      _ = - f (e 0 - e 1) := by rw [h01]
      _ = f (-(e 0 - e 1)) := (hodd (e 0 - e 1)).symm
  have hd12 : e 1 - e 2 = e 0 - e 1 := by
    apply hinj
    rw [h12, h01]
  have he : e 0 = e 1 := by linarith
  have hf0 : f 0 = 0 := by
    have h := hodd 0
    simp only [neg_zero] at h
    linarith
  have hzero : e 0 - e 1 = 0 := sub_eq_zero.mpr he
  rw [hzero] at h01
  have ha0 : a = 0 := by linarith
  exact ha ha0

/-- A three-node non-symmetric matrix satisfying diagonal one, row sums one,
global A12, and nonzero off-diagonal entries. -/
theorem A12_three_node_circulation_exists :
    (∀ i : Fin 3, Ccirc (1 : ℝ) i i = 1) ∧
    (∀ i : Fin 3, ∑ j : Fin 3, Ccirc (1 : ℝ) i j = 1) ∧
    ((∑ i : Fin 3, ∑ j : Fin 3,
      if i = j then 0 else Ccirc (1 : ℝ) i j) = 0) ∧
    Ccirc (1 : ℝ) 0 1 ≠ 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact Ccirc_diag 1
  · exact Ccirc_row_sum 1
  · exact Ccirc_global_offdiag_zero 1
  · exact Ccirc_offdiag_nonzero 1 one_ne_zero
