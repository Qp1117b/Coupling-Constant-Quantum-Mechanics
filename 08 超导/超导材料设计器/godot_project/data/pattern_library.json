{
  "version": "1.0",
  "description": "超导材料模式库：从已知超导家族提取的L1-L3经验规则",
  "patterns": [
    {
      "pattern_id": "CUPRATE_LAYERED",
      "pattern_family": "铜氧化物",
      "applicable_when": {
        "must_contain": ["Cu", "O"],
        "any_of": ["La", "Y", "Bi", "Tl", "Hg", "Nd", "Sr", "Ba", "Ca"],
        "description": "化学式含Cu和O，且含稀土/碱土元素"
      },
      "layers": {
        "L1": {
          "conserved_substructures": ["CuO2平面层"],
          "variable_modules": ["电荷库层(CuO链/SrO/RbO/BiO)", "隔离层(BaO/SrO)", "层数n=1-6"],
          "forbidden_topologies": ["CuO2面内Cu-Cu直接键", "HgO双层与CuO2面共面"],
          "skeleton_rule": "CuO2无限层为母体，电荷库层交替插入，层数n决定c轴周期"
        },
        "L2": {
          "key_parameters": {
            "Cu_O_inplane": {"formula": "1.90-1.95", "unit": "Å", "window": [1.85, 2.00]},
            "Cu_O_Cu_angle": {"formula": "180 - 2*apical_offset", "unit": "°", "window": [165, 180]},
            "apical_O_distance": {"formula": "2.2 + 0.15*(n-1)", "unit": "Å", "window": [2.0, 2.6]},
            "interlayer_spacing": {"formula": "c / (2*n + 2)", "unit": "Å", "window": [3.0, 20.0]}
          },
          "conformation_notes": "CuO2面近正方形，apical-O沿c轴，面内键角趋180°(高Tc)"
        },
        "L3": {
          "space_group_map": {
            "n=1": "P4/mmm (La214)",
            "n=2": "I4/mmm (Y123脱氧)",
            "n=3": "I4/mmm (Bi2223)",
            "default": "I4/mmm"
          },
          "packing_constraints": {
            "bravais_lattice": "四方/正交",
            "z_formula": "1",
            "wyckoff_Cu": "4i(0,0,z)",
            "wyckoff_O_inplane": "4j(0.5,0,0)",
            "wyckoff_O_apical": "2b(0,0,0.5)"
          }
        }
      },
      "cross_layer_rules": [
        {"condition": "L1.n >= 3", "effect": "L3.space_group偏好四方/正交", "effect_L2": "c轴按f(n)=c1*(n+0.5)标度"},
        {"condition": "L2.apical_O < 2.35", "effect": "Tc提升概率高(电荷转移优化)"},
        {"condition": "L1.电荷库层=CuO链", "effect": "L3要求正交而非四方(如Y123)"}
      ],
      "counter_examples": [
        {"case": "La2CuO4未掺杂", "lesson": "反铁磁绝缘体，需电荷掺杂才超导"},
        {"case": "Ca过量占据Y位", "lesson": "破坏CuO2面，Tc骤降"}
      ],
      "metadata": {
        "confidence": 0.95,
        "sample_count": 50,
        "tc_range": "20-134K",
        "extraction_method": "文献综述+ICSD统计",
        "human_curated": true
      }
    },
    {
      "pattern_id": "PNICTIDE_FeAs",
      "pattern_family": "铁基超导",
      "applicable_when": {
        "must_contain": ["Fe"],
        "any_of": ["As", "P", "Se", "Te", "S"],
        "description": "化学式含Fe和pnictogen/chalcogen"
      },
      "layers": {
        "L1": {
          "conserved_substructures": ["FeAs4四面体层"],
          "variable_modules": ["碱金属/碱土金属插层", "氧氟层", "厚度n=1-3"],
          "forbidden_topologies": ["Fe-Fe直接键", "As-As面内键"],
          "skeleton_rule": "FeAs4四面体二维层为母体，载流子层交替插入"
        },
        "L2": {
          "key_parameters": {
            "Fe_As": {"formula": "2.35-2.45", "unit": "Å", "window": [2.30, 2.50]},
            "Fe_As_Fe_angle": {"formula": "109.47 ± 3", "unit": "°", "window": [106, 113]},
            "As_height": {"formula": "1.30-1.60", "unit": "Å", "window": [1.20, 1.70]},
            "interlayer_spacing": {"formula": "8.0 + 5.5*(n-1)", "unit": "Å", "window": [6.0, 20.0]}
          },
          "conformation_notes": "FeAs4四面体趋正(As高度~1.40Å)，键角趋109.47°时Tc最优"
        },
        "L3": {
          "space_group_map": {
            "n=1_1111": "P4/nmm (LnFeAsO)",
            "n=1_122": "I4/mmm (AeFe2As2)",
            "n=2_122": "I4/mmm",
            "default": "P4/nmm"
          },
          "packing_constraints": {
            "bravais_lattice": "四方",
            "z_formula": "2",
            "wyckoff_Fe": "2a(0,0,0)",
            "wyckoff_As": "2c(0,0.5,z)"
          }
        }
      },
      "cross_layer_rules": [
        {"condition": "L2.As_height接近1.40", "effect": "四面体趋正，Tc最优"},
        {"condition": "L2.Fe_As_Fe_angle偏离109.47°>5°", "effect": "Tc显著降低"},
        {"condition": "L1.插层=氧氟", "effect": "L3优先P4/nmm(1111型)"}
      ],
      "counter_examples": [
        {"case": "BaFe2As2母体", "lesson": "自旋密度波态，需掺杂/压力才超导"},
        {"case": "As高度>1.70", "lesson": "四面体过畸变，Tc<10K"}
      ],
      "metadata": {
        "confidence": 0.90,
        "sample_count": 30,
        "tc_range": "5-65K",
        "extraction_method": "文献综述+第一性计算",
        "human_curated": true
      }
    },
    {
      "pattern_id": "HYDRIDE_CAGED",
      "pattern_family": "氢化物",
      "applicable_when": {
        "must_contain": ["H"],
        "any_of": ["La", "Y", "Sc", "Ca", "Sr", "Ba", "Li", "Mg"],
        "description": "化学式含H和金属元素（高压笼状结构）"
      },
      "layers": {
        "L1": {
          "conserved_substructures": ["金属氢笼状结构"],
          "variable_modules": ["笼状拓扑(立方/六方)", "化学预压缩元素", "压力条件"],
          "forbidden_topologies": ["自由H2分子(非笼状)", "金属-金属直接键"],
          "skeleton_rule": "金属原子形成笼状骨架，H在间隙位形成高配位多面体"
        },
        "L2": {
          "key_parameters": {
            "M_H": {"formula": "2.0-2.4", "unit": "Å", "window": [1.8, 2.6]},
            "H_H": {"formula": "1.4-2.0", "unit": "Å", "window": [1.2, 2.2]},
            "H_coordination": {"formula": "9-12", "unit": "", "window": [8, 14]},
            "pressure": {"formula": "100-300", "unit": "GPa", "window": [50, 500]}
          },
          "conformation_notes": "H高配位(9-12)，化学预压缩降低所需压力"
        },
        "L3": {
          "space_group_map": {
            "cubic": "Fm-3m (LaH10)",
            "hexagonal": "P63/mmc",
            "default": "Fm-3m"
          },
          "packing_constraints": {
            "bravais_lattice": "立方/六方",
            "z_formula": "1-4",
            "wyckoff_H": "高位Wyckoff(24e/96i)"
          }
        }
      },
      "cross_layer_rules": [
        {"condition": "L2.H_coordination >= 10", "effect": "高Tc(声子频率高)"},
        {"condition": "L1.预压缩元素=La", "effect": "所需压力降低(~170GPa vs YH6的~180GPa)"},
        {"condition": "L2.pressure < 100", "effect": "常压或低压氢化物，Tc通常<50K"}
      ],
      "counter_examples": [
        {"case": "纯H2分子固体", "lesson": "需极高压力(~400GPa)才金属化"},
        {"case": "H配位<8", "lesson": "声子频率不足，Tc低"}
      ],
      "metadata": {
        "confidence": 0.80,
        "sample_count": 15,
        "tc_range": "40-250K(理论预测)",
        "extraction_method": "第一性计算+少量实验",
        "human_curated": true
      }
    },
    {
      "pattern_id": "BCS_CONVENTIONAL",
      "pattern_family": "BCS低温超导",
      "applicable_when": {
        "must_contain": [],
        "any_of": ["Nb", "Pb", "Sn", "Al", "V", "Ta", "Hg", "Tc_el"],
        "description": "传统金属/合金超导体（电子-声子耦合）"
      },
      "layers": {
        "L1": {
          "conserved_substructures": ["金属键网络"],
          "variable_modules": ["合金成分", "A15结构/BCC/FCC"],
          "forbidden_topologies": ["绝缘间隙"],
          "skeleton_rule": "金属键连续网络，高态密度费米面"
        },
        "L2": {
          "key_parameters": {
            "nearest_neighbor": {"formula": "2.5-3.5", "unit": "Å", "window": [2.0, 4.0]},
            "debye_temperature": {"formula": "200-500", "unit": "K", "window": [100, 600]},
            "dos_fermi": {"formula": "高", "unit": "states/eV", "window": [0.1, 10.0]}
          },
          "conformation_notes": "高Debye温度+高费米态密度→高Tc"
        },
        "L3": {
          "space_group_map": {
            "A15": "Pm-3n (Nb3Sn)",
            "BCC": "Im-3m",
            "FCC": "Fm-3m",
            "default": "Im-3m"
          },
          "packing_constraints": {
            "bravais_lattice": "立方",
            "z_formula": "2-8"
          }
        }
      },
      "cross_layer_rules": [
        {"condition": "L3.space_group=A15", "effect": "Tc最优(Nb3Sn 18K, Nb3Ge 23K)"},
        {"condition": "L2.debye_temperature > 400", "effect": "Tc上限~25K(BCS极限)"}
      ],
      "counter_examples": [
        {"case": "Tc>30K的BCS材料", "lesson": "超出强耦合BCS范围，需非传统机制"}
      ],
      "metadata": {
        "confidence": 0.99,
        "sample_count": 100,
        "tc_range": "1-23K",
        "extraction_method": "实验数据+McMillan公式",
        "human_curated": true
      }
    }
  ],
  "pattern_mixing_rules": {
    "allowed": [
      {"from": "CUPRATE_LAYERED.L1.超导层", "to": "PNICTIDE_FeAs.L1.电荷库层", "note": "跨家族电荷库混合(理论探索)"}
    ],
    "forbidden": [
      {"conflict": "CuO2面与FeAs4四面体在同一层片内共面", "reason": "结构不兼容"}
    ]
  },
  "conflict_resolution_policy": {
    "same_family": "按置信度裁决",
    "cross_family": "要求用户覆盖",
    "physics_hard_constraint": "永远优先"
  }
}