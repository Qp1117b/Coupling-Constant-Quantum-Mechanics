<http://cqm.local/lean#FGChain> a cqm:LeanLibrary ;
    rdfs:label "FGChain" ;
    cqm:leanSymbol "CurvatureOperator",
        "FiberBundle",
        "Hierarchy",
        "Observable",
        "SyncOperator" .

cqm:PhysicsConcept a owl:Class ;
    rdfs:subClassOf cqm:Concept .

cqm:NumberTheoryConcept a owl:Class ;
    rdfs:subClassOf cqm:Concept .

cqm:Hyperedge a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cqm:Concept ;
            owl:onProperty cqm:hasConclusion ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cqm:Concept ;
            owl:onProperty cqm:hasPremise ],
        owl:Thing .

cqm:Statement a owl:Class ;
    rdfs:subClassOf cqm:Proposition .

cqm:GapItem a owl:Class ;
    rdfs:subClassOf cqm:Gap .

cqm:Concept a owl:Class ;
    rdfs:subClassOf owl:Thing .

cqm:Argument a owl:Class ;
    rdfs:subClassOf owl:Thing .

cqm:Evidence a owl:Class ;
    rdfs:subClassOf owl:Thing .

[] a owl:AllDisjointClasses ;
    owl:members ( cqm:CFTConcept cqm:RelationTypeConcept cqm:GeometryConcept cqm:GravityLevelConcept cqm:MathStructureConcept cqm:NumberTheoryConcept cqm:OntologyConcept cqm:PhysicsConcept cqm:FrameworkConcept cqm:FiberBundleConcept cqm:GroupTheoryConcept cqm:DimensionConcept ) .

