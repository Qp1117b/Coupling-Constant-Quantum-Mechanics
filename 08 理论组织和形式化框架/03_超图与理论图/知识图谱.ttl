cqm:hasPremise a owl:ObjectProperty ;
    rdfs:domain cqm:Hyperedge ;
    rdfs:range cqm:Concept .

cqm:mappedFrom a owl:ObjectProperty ;
    owl:inverseOf cqm:mapsTo .

cqm:mapsTo a owl:ObjectProperty ;
    rdfs:domain cqm:Concept ;
    rdfs:range cqm:Concept ;
    owl:inverseOf cqm:mappedFrom .

cqm:subsumedIn a owl:ObjectProperty ;
