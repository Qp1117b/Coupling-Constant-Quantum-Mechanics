cqm:conclusionText a owl:AnnotationProperty .

cqm:definition a owl:AnnotationProperty .

cqm:derivedFrom a owl:ObjectProperty ;
    rdfs:range cqm:Evidence .

cqm:equivalentTo a owl:ObjectProperty ;
    rdfs:domain cqm:Concept ;
    rdfs:range cqm:Concept .

cqm:evidenceConfidence a owl:AnnotationProperty .

cqm:evidenceKind a owl:AnnotationProperty .

cqm:evidenceMethod a owl:AnnotationProperty .

cqm:evidenceQuote a owl:AnnotationProperty .

cqm:evidenceSpan a owl:AnnotationProperty .

cqm:gapCode a owl:AnnotationProperty .

cqm:gapPrecedes a owl:ObjectProperty ;
    rdfs:domain cqm:Gap ;
    rdfs:range cqm:Gap .

cqm:humanVerified a owl:AnnotationProperty .

cqm:mentionedIn a owl:ObjectProperty ;
    rdfs:domain cqm:Proposition ;
    rdfs:range cqm:Concept .

cqm:premisesText a owl:AnnotationProperty .

cqm:relationType a owl:AnnotationProperty .

cqm:sourceDoc a owl:AnnotationProperty .

cqm:sourceLoc a owl:AnnotationProperty .

cqm:status a owl:AnnotationProperty .

cqm:synonyms a owl:AnnotationProperty .

