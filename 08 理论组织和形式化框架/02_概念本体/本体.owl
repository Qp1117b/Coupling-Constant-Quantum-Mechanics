<owl:NamedIndividual rdf:about="#EV_C001">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C001</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D006</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">735-796</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">它根据因果结构的不同深度和广度分化：FG 与 GR 是引力的两种形态，前时空在引力之前（不属引力）。</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/high</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7.409</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C002">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C002</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D005</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1162-1230</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理论主线：（1）物质先在，存在先于过程——质子/中子作为有限本体先于再生产闭环，再生产 $\mu^2=\mu$ 是维持而非生成；</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/high</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6.441</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C003">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C003</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D005</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3840-3879</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">再生产是有限本体（质子/中子）维持自身存在的操作，而非创造自身的操作。</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/medium</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4.509</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C004">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C004</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D005</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">643-731</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQM 直接建立在因果集（Causal Set）、关系量子力学（RQM）与圈量子引力（LQG）三大理论基础之上，但进行了根本性的本体论重构：量子化的对象是耦合常数本身。</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/medium</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.679</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C005">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C005</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D005</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15879-16081</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">$$\text{离散自由度（因果集事件）} \xrightarrow{\text{前核子自组织 + 粗粒化}} \text{禁闭边界组合结构（4-单纯形）} \xrightarrow{\text{边-面关联}} M = E^T E \xrightarrow{\text{本征值分析}} \{9,4,1\} \xrightarrow{S_5 \text{表示论}} \text{SU(5) 规范群结构}$$</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/high</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7.055</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C006">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C006</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">907-938</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">内容：量子引力的物理实在位于单个质子／中子的禁闭内部。</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/high</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5.762</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C007">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C007</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D007</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1927-1972</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQM（耦合常数量子力学）提出了一个更激进的立场：数学结构本身是物质自组织的化石。</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/high</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5.0</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C008">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C008</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D015</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1456-1541</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zurek 等人提出的环境诱导退相干理论（Environment-Induced Decoherence, EID）试图通过系统与环境的纠缠来解释经典世界的涌现。</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/medium</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.844</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C009">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C009</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D007</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">967-1040</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因果网络同步理论（CNST）是耦合常数量子力学（CQM）的存在论基底，是一个因果动力学理论——描述引力如何使具体的因果结构/关系成为可能。</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/high</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">13.549</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C011">
