  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4.647</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

