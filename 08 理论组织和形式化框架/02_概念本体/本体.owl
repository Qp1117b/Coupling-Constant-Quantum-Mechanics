  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D012</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9628-9746</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">相变量子 $☯$ ｜ $☯ = \frac{d}{ds}\ln\xi(s)\big|_{s=1} \approx 0.02309570897$ ｜ GL(5)固定层级（黎曼 $\xi$ 函数） ｜ 耦合动量条件的相变量子</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/high</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5.253</evidenceConfidence>
