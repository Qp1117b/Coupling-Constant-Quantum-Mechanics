</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subsumes">
  <owl:inverseOf rdf:resource="#subsumedIn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPremise">
  <rdfs:domain rdf:resource="#Hyperedge"/>
  <rdfs:range rdf:resource="#Concept"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasConclusion">
  <rdfs:domain rdf:resource="#Hyperedge"/>
  <rdfs:range rdf:resource="#Concept"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#gapPrecedes">
  <rdfs:domain rdf:resource="#Gap"/>
  <rdfs:range rdf:resource="#Gap"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mentionedIn">
  <rdfs:domain rdf:resource="#Proposition"/>
  <rdfs:range rdf:resource="#Concept"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#derivedFrom">
