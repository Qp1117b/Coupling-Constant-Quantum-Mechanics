<owl:NamedIndividual rdf:about="#EV_C024">
  <rdf:type rdf:resource="#Evidence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C024</rdfs:label>
  <evidenceKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">概念</evidenceKind>
  <sourceDoc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D001</sourceDoc>
  <evidenceSpan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10808-11383</evidenceSpan>
  <evidenceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FG 贝里曲率与Regge曲率的关联 ｜ 文献调研研究论文：贝里曲率（Berry curvature）文献谱系（奠基理论→能带物理→超导量子几何→第一性原理计算）；与Regge曲率的共同数学骨架（联络—曲率—和乐，Wilson环同构$W_v=\exp(i\delta_v\hat{T}_\ell)$，陈数/离散Gauss–Bonnet平行）；确定物理交点（锥形时空亏角和乐）；直接连接文献缺失的说明（关联是结构性的，非文献性的）；δintrinsic断链的量子几何启示（超流刚度由量子度规决定）</evidenceQuote>
  <evidenceMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/medium</evidenceMethod>
  <evidenceConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.0</evidenceConfidence>
  <humanVerified rdf:datatype="http://www.w3.org/2001/XMLSchema#string">False</humanVerified>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EV_C025">
