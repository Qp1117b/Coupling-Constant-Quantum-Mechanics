<owl:Ontology rdf:about="http://cqm.local/ontology"/>

<owl:ObjectProperty rdf:about="#evolvesTo">
  <rdfs:domain rdf:resource="#Concept"/>
  <rdfs:range rdf:resource="#Concept"/>
  <owl:inverseOf rdf:resource="#evolvedFrom"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#evolvedFrom">
  <owl:inverseOf rdf:resource="#evolvesTo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mapsTo">
  <rdfs:domain rdf:resource="#Concept"/>
  <rdfs:range rdf:resource="#Concept"/>
  <owl:inverseOf rdf:resource="#mappedFrom"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mappedFrom">
  <owl:inverseOf rdf:resource="#mapsTo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#equivalentTo">
  <rdfs:domain rdf:resource="#Concept"/>
  <rdfs:range rdf:resource="#Concept"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dependsOn">
  <rdfs:domain rdf:resource="#Proposition"/>
  <rdfs:range rdf:resource="#Concept"/>
  <owl:inverseOf rdf:resource="#dependedOnBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dependedOnBy">
  <owl:inverseOf rdf:resource="#dependsOn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#conceptDependsOn">
  <rdfs:domain rdf:resource="#Concept"/>
  <rdfs:range rdf:resource="#Concept"/>
  <owl:inverseOf rdf:resource="#conceptDependedOnBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#conceptDependedOnBy">
  <owl:inverseOf rdf:resource="#conceptDependsOn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subsumedIn">
  <rdfs:domain rdf:resource="#Concept"/>
  <rdfs:range rdf:resource="#Concept"/>
