extends Node

var _materials: Array = []

func _ready():
	_build_database()

func get_all() -> Array:
	return _materials

func get_by_name(sc_name: String) -> Dictionary:
	for m in _materials:
		if m.name == sc_name:
			return m
	return {}

func infer_pairing_symmetry(material: Dictionary) -> int:
	var family = material.get("family", "")
	var desc = material.get("desc", "")
	var formula = material.get("formula", "")
	if family.find("铜氧化物") >= 0 or desc.find("d波") >= 0:
		return 1
	if desc.find("p波") >= 0:
		return 2
	if family.find("铁基") >= 0 or formula.find("MgB2") >= 0:
		return 3
	return 0

